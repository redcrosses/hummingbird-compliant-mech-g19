/CLEAR
/PREP7
pi = acos(-1) !bruh
*AFUN,DEG
L1=73.8646673450504
L2=27.5308690719627
L3=84.4734335441051
L4=150
L5=128.402539267867
L6=48.8866075220079
L7=27.1708576611995
L8=129.547303320354
L9=25
zoff = -10 
sf = 6                  ! in-plane spacing between the two side-by-side flexures [mm]

LB = 4.444*4
Lgrnd = 4.444*4
LD = 12.33*1.5
LC = 2.27*2
LP = 2.27*2

theta1=-2.10422939883268
th2=89.595
th5=105.144
th6=79.448
th7=21.111
th8=68.64
th9=136.79

K,1,0,0,0
K,2,L1*cos(theta1),L1*sin(theta1),0
K,12,KX(2)-Lgrnd/2*cos(th6-th7),KY(2)-Lgrnd/2*sin(th6-th7),0
K,3,L2*cos(th2),L2*sin(th2),zoff          ! A on the triangle plane
K,13,KX(3),KY(3),0      ! crank end of the revolute pin (z=0)
K,23,KX(3),KY(3),0      ! pin-side end of the A connector (z=0)
K,4,KX(2)+L6*cos(th6),KY(2)+L6*sin(th6),zoff   ! B on the triangle plane
K,24,KX(4),KY(4),0      ! B at z=0: flexure end
K,14,KX(2)+(L6-lB)*cos(th6),KY(2)+(L6-lB)*sin(th6),0
K,7,KX(3)-L5*cos(th5),KY(3)-L5*sin(th5),zoff   ! P on the triangle plane
K,27,KX(7),KY(7),0      ! P at z=0: flexure end
K,5,KX(7)-L9*cos(th9),KY(7)-L9*sin(th9),0
K,17,KX(7)-LP*cos(th9),KY(7)-LP*sin(th9),0
K,15,KX(7)-(L9-LC)*cos(th9),KY(7)-(L9-LC)*sin(th9),0
K,6,KX(5)+L8*cos(th8),KY(5)+L8*sin(th8),0
K,16,KX(5)+(L8-LD)*cos(th8),KY(5)+(L8-LD)*sin(th8),0

! --- second flexure, side by side with the first: same direction, offset sf in-plane
! offset direction = flexure direction rotated +90 deg  ->  (-sin(phi), cos(phi))
phig = th6-th7+180      ! direction of the ground flexure (from KP2 toward KP12)
K,22,KX(2)-sf*sin(phig),KY(2)+sf*cos(phig),0       ! O4-body end, 2nd ground flexure
K,32,KX(12)-sf*sin(phig),KY(12)+sf*cos(phig),0     ! ground end, 2nd ground flexure
K,34,KX(14)-sf*sin(th6),KY(14)+sf*cos(th6),0       ! O4-body end, 2nd B flexure
K,44,KX(24)-sf*sin(th6),KY(24)+sf*cos(th6),0       ! triangle-side end, 2nd B flexure
K,36,KX(16)-sf*sin(th8),KY(16)+sf*cos(th8),0       ! link-8 end, 2nd D flexure
K,46,KX(6)-sf*sin(th8),KY(6)+sf*cos(th8),0         ! O4-body end, 2nd D flexure

LSTR,1,2 !line 1 (ground reference, not meshed)
LSTR,1,13 !line 2: crank, pinned to triangle
LSTR,3,4
LSTR,7,4
LSTR,7,3
LSTR,2,14
LSTR,2,6
LSTR,5,16
LSTR,17,15 !line 9
LSTR,14,24 !line 10 (flexure at B)
LSTR,2,12
LSTR,16,6
LSTR,27,17 !line 13 (flexure at P)
LSTR,15,5 !line 14
LSTR,24,4 !line 15: Z connector at B
LSTR,27,7 !line 16: Z connector at P
LSTR,23,3 !line 17: Z connector at A
LSTR,34,44 !line 18: 2nd flexure at B
LSTR,22,32 !line 19: 2nd flexure at ground (O4)
LSTR,36,46 !line 20: 2nd flexure at D
LSTR,14,34 !line 21: in-plane rigid connector, B flexure, body side
LSTR,24,44 !line 22: in-plane rigid connector, B flexure, triangle side
LSTR,2,22  !line 23: in-plane rigid connector, ground flexure, body side
LSTR,16,36 !line 24: in-plane rigid connector, D flexure, link-8 side
LSTR,6,46  !line 25: in-plane rigid connector, D flexure, body side

/PNUM,KP,1
/PNUM,LINE,1
/VIEW,1,,,1
/ANG,1
/REPLOT
KPLOT
LPLOT

!!!element types!!!
Eplas=2000
Esteel=185e3
ET,1,BEAM188
KEYOPT,1,3,2

!!!material properties!!!
MP,EX,1,Eplas
MP,PRXY,1,0.35
MP,EX,2,Esteel
MP,PRXY,2,0.3

!!!cross sections!!!
SECTYPE,1,BEAM,RECT,PLASTIC
SECDATA,5,10 !5x10mm rectangle
SECTYPE,2,BEAM,RECT,STEEL
SECDATA,0.1,10 !0.1x10mm rectangle (check: your old comment said 0.4)
SECTYPE,3,BEAM,CSOLID,PLASTIC
SECDATA,3

!!!steel flexures (lines 10-14 and the three added parallel flexures 18-20)
LSEL,S,LINE,,10,14
LSEL,A,LINE,,18,20
CM,STEEL_FLEX,LINE
LATT,2,,1,,,,2
LESIZE,ALL,,,20
ALLSEL

!!!plastic links (lines 2-9)
LSEL,S,LINE,,2,9
CM,PLASTIC,LINE
LATT,1,,1,,,,1
LESIZE,ALL,,,1

!!!Z connectors (lines 15-17): round plastic section
LSEL,S,LINE,,15,17
CM,CONNECTORS_Z,LINE
LATT,1,,1,,,,3
LESIZE,ALL,,,1

!!!in-plane rigid connectors for the added flexures (lines 21-25): plastic 5x10 section
LSEL,S,LINE,,21,25
CM,CONNECTORS_XY,LINE
LATT,1,,1,,,,1
LESIZE,ALL,,,1

!!!mesh everything at once
LSEL,S,LINE,,2,25
LMESH,ALL
ALLSEL
/ESHAPE,1
!EPLOT
!SLIST,ALL,,,FULL

!!!node numbers at the keypoints we need!!!
KSEL,S,KP,,3
NSLK,S
*GET,nA,NODE,0,NUM,MIN      ! triangle node at A
ALLSEL
KSEL,S,KP,,13
NSLK,S
*GET,nCr,NODE,0,NUM,MIN     ! crank node at A
ALLSEL
KSEL,S,KP,,1
NSLK,S
*GET,nO2,NODE,0,NUM,MIN     ! crank base (input)
ALLSEL
KSEL,S,KP,,12
NSLK,S
*GET,nG,NODE,0,NUM,MIN      ! ground end of the O4 flexure
ALLSEL
KSEL,S,KP,,32
NSLK,S
*GET,nG2,NODE,0,NUM,MIN     ! ground end of the 2nd O4 flexure (also fixed)
ALLSEL

!!!revolute pin at A: UX,UY shared, ROTZ free!!!
CP,1,UX,nA,nCr
CP,2,UY,nA,nCr
CP,3,UZ,nA,nCr

! In /SOLU, in addition to D,nG,ALL,0 also fix the second ground end:
!   D,nG2,ALL,0
