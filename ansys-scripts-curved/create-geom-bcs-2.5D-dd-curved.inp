/CLEAR
/PREP7
pi = acos(-1) !bruh
scale = 2
*AFUN,DEG
L1=73.8646673450504*scale
L2=27.5308690719627*scale
L3=84.4734335441051*scale
L4=150*scale
L5=128.402539267867*scale
L6=48.8866075220079*scale
L7=27.1708576611995*scale
L8=129.547303320354*scale
L9=25*scale
zoff = -10*scale

LB = 4.444*4*scale
! LB = L6 - scale !distributed
Lgrnd = 4.444*7*scale
LD = 12.33*2*scale
LC = 2.27*4*scale
LP = 2.27*4*scale

!!!element types!!!
Eplas=2000
Esteel=185e3
ET,1,BEAM188
KEYOPT,1,3,2

!!!material properties!!!
MP,EX,1,Eplas
MP,PRXY,1,0.35
MP,EX,2,Esteel
MP,PRXY,2,0.3

!!!cross sections!!!
SECTYPE,1,BEAM,RECT,PLASTIC
SECDATA,5*scale,10*scale !5x10mm rectangle
SECTYPE,2,BEAM,RECT,STEEL
SECDATA,0.1,10 !0.1x10mm rectangle
SECTYPE,3,BEAM,CSOLID,PLASTIC
SECDATA,3*scale
SECTYPE,4,BEAM,RECT,STEEL
SECDATA,0.1,10 !0.4x10mm rectangle

theta1=-2.10422939883268
th2=89.595
th5=105.144
th6=79.448
th7=21.111
th8=68.64
th9=136.79


K,1,0,0,0
K,2,L1*cos(theta1),L1*sin(theta1),0
K,22,KX(2)+10*sin(th6),KY(2)-10*cos(th6),0
K,12,KX(2)-Lgrnd/2*cos(th6-th7),KY(2)-Lgrnd/2*sin(th6-th7),0
K,3,L2*cos(th2),L2*sin(th2),zoff          ! A on the triangle plane
K,13,KX(3),KY(3),0      ! crank end of the revolute pin (z=0)
K,23,KX(3),KY(3),0      ! pin-side end of the A connector (z=0)
K,4,KX(2)+L6*cos(th6),KY(2)+L6*sin(th6),zoff   ! B on the triangle plane
K,24,KX(4),KY(4),0      ! B at z=0: flexure end
K,14,KX(2)+(L6-lB)*cos(th6),KY(2)+(L6-lB)*sin(th6),0
K,7,KX(3)-L5*cos(th5),KY(3)-L5*sin(th5),zoff   ! P on the triangle plane
K,27,KX(7),KY(7),0      ! P at z=0: flexure end
K,5,KX(7)-L9*cos(th9),KY(7)-L9*sin(th9),0
K,55,KX(5)+10*sin(th9),KY(5)-10*cos(th9),0
K,17,KX(7)-LP*cos(th9),KY(7)-LP*sin(th9),0
K,15,KX(7)-(L9-LC)*cos(th9),KY(7)-(L9-LC)*sin(th9),0
K,6,KX(5)+L8*cos(th8),KY(5)+L8*sin(th8),0
K,66,KX(6)-10*sin(th8),KY(6)+10*cos(th8),0
K,16,KX(5)+(L8-LD)*cos(th8),KY(5)+(L8-LD)*sin(th8),0

dx = KX(66)-KX(22)
dy = KY(66)-KY(22)
dl = SQRT(dx**2+dy**2)
dx = dx/dl
dy = dy/dl
nx = -dy                      ! unit normal to line 22-66
ny =  dx            ! put the center on the side of K16
Rarc = 100
K,99, KX(66)+Rarc*nx, KY(66)+Rarc*ny, 0

LSTR,1,2 !line 1 (ground reference, not meshed)

LSTR,1,13 !line 2: crank, pinned to triangle
LSTR,2,14
LSTR,3,4
LSTR,7,4
LSTR,7,3
LSTR,2,22
LSTR,22,66
LSTR,5,55
LSTR,55,16
LSTR,17,15 !line 11

LSTR,14,24 !line 12 (flexure at B)
LSTR,2,12
! LSTR,16,6
LARC,16,66,99,Rarc
LSTR,27,17 !line 15 (flexure at P)
LSTR,15,5 !line 16

LSTR,24,4 !line 17: Z connector at B
LSTR,27,7 !line 18: Z connector at P
LSTR,23,3 !line 19: Z connector at A

/PNUM,KP,1
/PNUM,LINE,1
/VIEW,1,,,1
/ANG,1
/REPLOT
KPLOT
LPLOT

!!!steel flexures (lines 10-14)
LSEL,S,LINE,,12,19
CM,STEEL_FLEX,LINE
LATT,2,,1,,,,2
LESIZE,ALL,,,20
ALLSEL

LSEL,S,LINE,,12,12
CM,STEEL_FLEX,LINE
LATT,2,,1,,,,4
LESIZE,ALL,,,20
ALLSEL

!!!plastic links (lines 2-9)
LSEL,S,LINE,,2,11
CM,PLASTIC,LINE
LATT,1,,1,,,,1
LESIZE,ALL,,,1

LSEL,S,LINE,,17,19        ! Z connectors are plastic too
CM,PLASTIC,LINE
LATT,1,,1,,,,3
LESIZE,ALL,,,1

!!!mesh everything at once
LSEL,S,LINE,,2,19
LMESH,ALL
ALLSEL
/ESHAPE,1
EPLOT
SLIST,ALL,,,FULL

!!!node numbers at the keypoints we need!!!
KSEL,S,KP,,3
NSLK,S
*GET,nA,NODE,0,NUM,MIN      ! triangle node at A
ALLSEL
KSEL,S,KP,,13
NSLK,S
*GET,nCr,NODE,0,NUM,MIN     ! crank node at A
ALLSEL
KSEL,S,KP,,1
NSLK,S
*GET,nO2,NODE,0,NUM,MIN     ! crank base (input)
ALLSEL
KSEL,S,KP,,12
NSLK,S
*GET,nG,NODE,0,NUM,MIN      ! ground end of the O4 flexure
ALLSEL

!!!revolute pin at A: UX,UY shared, ROTZ free!!!
CP,1,UX,nA,nCr
CP,2,UY,nA,nCr
CP,3,UZ,nA,nCr
